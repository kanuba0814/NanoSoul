# ---- ESP-IDF / 固件 ----
build/
sdkconfig
sdkconfig.old
managed_components/
dependencies.lock
*.map
*.bin
*.elf

# ---- Python / circuit-synth ----
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/

# ---- circuit-synth 生成的 3D / 缓存（保留 .kicad_sym/.pretty 源） ----
pcb/libs/**/*.3dshapes/
pcb/libs/**/*.wrl
pcb/libs/**/*.step
pcb/output/**/*-backups/
pcb/output/**/fp-info-cache
*.kicad_prl

# ---- 杂项 ----
*.bak
*.tmp
.DS_Store

# 本地工具缓存
.cache/
.clangd

# 本地配置
config/

# PCB 生成的临时/报告产物
pcb/output/**/*.rpt
pcb/output/**/*.lck
pcb/output/**/~*
pcb/output/**/.history/
pcb/output/**/*.dsn
pcb/output/**/*.ses
pcb/output/**/fr.log
pcb/output/_par.json
pcb/output/**/_pos.csv
pcb/output/final70_*.png
pcb/output/fab/gerbers/NanoSoul-B_Adhesive.*
pcb/output/fab/gerbers/NanoSoul-B_Courtyard.*
pcb/output/fab/gerbers/NanoSoul-B_Fab.*
pcb/output/fab/gerbers/NanoSoul-F_Adhesive.*
pcb/output/fab/gerbers/NanoSoul-F_Courtyard.*
pcb/output/fab/gerbers/NanoSoul-F_Fab.*
pcb/output/fab/gerbers/NanoSoul-In1_Cu.*
pcb/output/fab/gerbers/NanoSoul-In2_Cu.*
pcb/output/fab/gerbers/NanoSoul-Margin.*
pcb/output/fab/gerbers/NanoSoul-User_*

# derived emote assets (regenerated by tools/emote_repack.py from spiffs_image/)
assets/emote/

# emote source packs are the emotion design + build input for emote_repack.py
!spiffs_image/*.bin

# ---- 个人本地 Claude 配置（.claude/skills 与 settings.json 仍可提交） ----
.claude/settings.local.json

# ---- 外壳 CAD：保留 .py/.scad/.md 源，忽略生成的 3D/渲染 ----
enclosure/*.step
enclosure/*.stl
enclosure/*.png
enclosure/model/.preview/
enclosure/_archive/

# ---- 项目视频（素材不入库，保留脚本）----
/projects/video/*
!/projects/video/work/
/projects/video/work/*
!/projects/video/work/*.py
!/projects/video/work/narration/

# ---- 根目录散落的 DRC 报告 ----
/NanoSoul-drc.rpt
sdcard_template/nanosoul/config.json
