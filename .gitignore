# ---- ESP-IDF / 固件 ----
build/
sdkconfig
sdkconfig.old
managed_components/
dependencies.lock
*.map
*.bin
*.elf

# ---- Python / circuit-synth ----
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/

# ---- circuit-synth 生成的 3D / 缓存（保留 .kicad_sym/.pretty 源） ----
pcb/libs/**/*.3dshapes/
pcb/libs/**/*.wrl
pcb/libs/**/*.step
pcb/output/**/*-backups/
pcb/output/**/fp-info-cache
*.kicad_prl

# ---- 杂项 ----
*.bak
*.tmp
.DS_Store
# LibreOffice 打开文档时的临时锁文件
.~lock.*#

# PCB 生成的临时/报告产物
pcb/output/**/*.rpt
pcb/output/**/*.lck
pcb/output/**/~*
pcb/output/**/.history/
pcb/output/**/*.dsn
pcb/output/**/*.ses
pcb/output/**/fr.log

# derived emote assets (regenerated by tools/emote_repack.py from spiffs_image/)
assets/emote/

# emote source packs are the emotion design + build input for emote_repack.py
!spiffs_image/*.bin

# ---- 个人本地 Claude 配置（.claude/skills 与 settings.json 仍可提交） ----
.claude/settings.local.json

# ---- 竞赛作品报告：保留 build_report.py/figures/diagrams/模板源，忽略脚本重跑生成的成品 ----
docs/report/*.docx
docs/report/*.pdf

# ---- 内部工作方法文档（作战手册/流程风险/外包需求规格）：保留本地、不入公开仓库 ----
docs/_internal/

# ---- 外壳 CAD：保留 .py/.scad/.md 源，忽略生成的 3D/渲染 ----
enclosure/*.step
enclosure/*.stl
enclosure/*.png
enclosure/model/.preview/

# ---- 根目录散落的 DRC 报告 ----
/NanoSoul-drc.rpt

# 真实凭证配置（本地调试/SD 卡母本），绝不入库
sdcard_template/nanosoul/config.json
config/config.json

# clangd 本地索引缓存
.cache/
.clangd
