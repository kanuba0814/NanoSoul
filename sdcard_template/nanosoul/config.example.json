{
  "_comment": "Copy to /sdcard/nanosoul/config.json on the SD card and fill in. Real API keys stay ON THE CARD, never in git.",
  "wifi":   { "ssid": "your-ssid", "password": "your-pass" },
  "chat":   {
    "provider": "anthropic",
    "base_url": "https://api.anthropic.com",
    "api_key": "sk-ant-...",
    "model": "claude-opus-4-8",
    "max_tokens": 512,
    "system_prompt": "You are NanoSoul, a small desktop companion robot. Reply briefly and warmly."
  },
  "stt":    { "base_url": "https://api.openai.com", "api_key": "sk-...", "model": "whisper-1" },
  "tts":    { "base_url": "https://api.openai.com", "api_key": "sk-...", "model": "tts-1", "voice": "alloy" },
  "behavior": { "near_lo": 0.04, "near_hi": 0.18, "frontal_thresh": 0.7, "gaze_hold_ms": 1500, "gaze_cooldown_s": 30, "idle_scan": false, "autonomy": true, "autonomy_idle_s": 90 },
  "mood": { "enabled": true, "energy_init": 0.5, "social_init": 0.5, "social_tau_min": 10 },
  "pc": { "stale_s": 15, "respect_dnd": true, "quiet_work": true, "quiet_meeting": true, "invite_idle_s": 300, "invite_cooldown_min": 60 },
  "light": { "dark_lux": 10, "bright_lux": 30, "dark_hold_s": 30 },
  "imu": { "tap_th": 3.0, "lift_g_dev": 0.15, "lift_hold_ms": 300, "place_still_ms": 1500, "tilt_deg": 8 },
  "protect": { "stall_ma": 350, "stall_ms": 200, "stall_retry": 3 },
  "move": { "approach_budget_cm": 15, "nudge_cm": 4, "ramp_ms": 100, "jitter_pct": 15 },
  "motion": { "enabled": false, "max_duty_pct": 40 },
  "companion": { "enabled": true, "token": "change-me" },
  "debug":  { "overlay": true, "log_level": "info" }
}
